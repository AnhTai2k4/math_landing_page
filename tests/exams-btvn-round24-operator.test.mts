import assert from 'node:assert/strict';
import {pathToFileURL} from 'node:url';
import {join} from 'node:path';
import {createBtvnPublishHandler} from '../server/btvn/publish-handler';
import {scorebookResult} from '../server/btvn/publish-scorebook';
const root=process.env.MTM_ROOT??process.cwd();
const {reopenByRules}=await import(pathToFileURL(join(root,'scripts/reopen-btvn-by-rules.mjs')).href);
const {withClassOpenings}=await import(pathToFileURL(join(root,'scripts/publish-btvn-lesson.mjs')).href);
const material={lessonCode:'fixture-24',classNames:['2K9 8+'],date:'2026-10-17'};
const env={BTVN_PUBLISH_URL:'https://fixture.supabase.co/functions/v1/mtm-btvn-publish',BTVN_PUBLISH_SECRET:'local-fixture-only-'.repeat(3)};
const calls:any[]=[];const transport=async(url:string,options:any)=>{const body=JSON.parse(options.body);calls.push(body);assert.equal(url,env.BTVN_PUBLISH_URL);return new Response(JSON.stringify(body.action==='opening_materials'?[material]:{status:'updated'}));};
const dry=await reopenByRules('--all',{materials:[material],transport});
assert.equal(dry.results[0].written,false);assert.deepEqual(dry.results[0].classOpensAt,{'2K9 8+':'2026-10-16T19:30:00+07:00'});assert.equal(calls.length,0);
assert.equal((await reopenByRules('fixture-24',{env,transport})).count,1);assert.deepEqual(calls.map(c=>c.action),['opening_materials']);calls.length=0;
await reopenByRules('--all',{live:true,env,transport});assert.deepEqual(calls.map(c=>c.action),['opening_materials','update_material']);
assert.deepEqual(calls[1].material,{classOpensAt:{'2K9 8+':'2026-10-16T19:30:00+07:00'}});assert.deepEqual(Object.keys(calls[1]),['action','lesson_key','material']);
calls.length=0;
await assert.rejects(()=>reopenByRules('--all',{live:true,materials:[material,{...material,lessonCode:'bad',date:'2026-02-30'}],env,transport}));assert.equal(calls.length,0);
await assert.rejects(()=>reopenByRules('missing',{materials:[material]}));
await assert.rejects(()=>reopenByRules(undefined,{materials:[material]}));
assert.equal((await reopenByRules('--all',{materials:[]})).count,0);
assert.deepEqual((await withClassOpenings({material})).material.classOpensAt,{'2K9 8+':'2026-10-16T19:30:00+07:00'});
let readPayload:any;const handler=createBtvnPublishHandler({async rpc(action,payload){assert.equal(action,'opening_materials');readPayload=payload;return [{...material,exam:'PRIVATE',phone:'PRIVATE'}];},async upload(){assert.fail();}},env.BTVN_PUBLISH_SECRET);
const request=(body:any)=>handler(new Request('https://fixture.invalid',{method:'POST',headers:{'X-MTM-Publish-Secret':env.BTVN_PUBLISH_SECRET},body:JSON.stringify(body)}));
const response=await request({action:'opening_materials',lesson_key:'fixture-24'});assert.equal(response.status,200);assert.deepEqual(readPayload,{p_code:'fixture-24'});assert.doesNotMatch(await response.text(),/PRIVATE/);
assert.equal((await request({action:'opening_materials',apply:true})).status,422);
assert.equal((await request({action:'opening_materials',lesson_key:null})).status,422);
assert.deepEqual(scorebookResult('opening_materials',[{...material,exam:'PRIVATE'}]),[{...material,classDates:undefined}]);
console.log('ĐẠT đợt 24 operator: chỉ metadata, dry-run không ghi, live giả qua update_material, preflight toàn bộ, không đổi đề, publisher điền giờ mở.');
