import assert from 'node:assert/strict';import {writeFileSync} from 'node:fs';import {courses} from '../src/migration/catalogue';
import {nativeLessonUrl,resolveNativeLesson,nativePathForExam,nativePathForDocument,nativeCourseMetadata,nativeRouteKnown,publicSnapshot,fullLessonCount,NATIVE_COMPLETION} from '../src/native/model';import {routeMetadata} from '../src/migration/route-policy';
const rows:{name:string;pass:boolean;error?:string}[]=[];function test(name:string,fn:()=>void){try{fn();rows.push({name,pass:true});}catch(e){rows.push({name,pass:false,error:e instanceof Error?e.message:String(e)});}}
const origin='https://www.minhthanhmath.vn';
test('All 147 source lesson entries resolve inside MTM',()=>{let count=0;for(const c of courses)for(const s of c.sections)for(const l of s.lessons){const url=new URL(nativeLessonUrl(c,l),origin),m=resolveNativeLesson(url.pathname,url.search);assert.equal(url.origin,origin);assert.equal(m?.course.slug,c.slug);assert.equal(m?.lesson.slug,l.slug);assert.equal(m?.chapter.id,s.id);count++;}assert.equal(count,147);assert.equal(fullLessonCount,count);});
test('Lesson title/route cannot collide across courses',()=>{const urls=courses.flatMap(c=>c.sections.flatMap(s=>s.lessons.map(l=>nativeLessonUrl(c,l))));assert.equal(new Set(urls).size,147);});
test('Missing course slug does not select an arbitrary course',()=>assert.equal(resolveNativeLesson('/bai-hoc/anything',''),undefined));
test('Repeated courseSlug is rejected as ambiguous',()=>assert.equal(resolveNativeLesson('/bai-hoc/anything','?courseSlug=x&courseSlug=y'),undefined));
test('Malformed path encoding returns missing state instead of crashing',()=>assert.equal(resolveNativeLesson('/bai-hoc/%E0%A4%A','?courseSlug='+courses[0].slug),undefined));
test('Unknown lesson stays unknown',()=>assert.equal(resolveNativeLesson('/bai-hoc/definitely-missing','?courseSlug='+courses[0].slug),undefined));
test('First and final lesson have correct internal bounds',()=>{for(const c of courses){const ls=c.sections.flatMap(s=>s.lessons);if(!ls.length)continue;const first=new URL(nativeLessonUrl(c,ls[0]),origin),last=new URL(nativeLessonUrl(c,ls.at(-1)!),origin);assert.equal(resolveNativeLesson(first.pathname,first.search)?.previous,undefined);assert.equal(resolveNativeLesson(last.pathname,last.search)?.next,undefined);}});
test('Native title and canonical follow exact selected lesson',()=>{const c=courses.find(c=>c.sections.length)!,l=c.sections[0].lessons[0],url=new URL(nativeLessonUrl(c,l),origin),m=routeMetadata(url.pathname,'www.minhthanhmath.vn',url.search);assert.ok(m.title.includes(l.title));assert.equal(m.url,url.href);assert.ok(m.known);assert.equal(m.robots,'noindex, follow');});
test('Public course text maps all original course identities',()=>{assert.equal(publicSnapshot.courses.length,13);for(const c of courses){const meta=nativeCourseMetadata(c);assert.ok(meta);assert.equal(meta?.title,c.title);assert.equal(meta?.grade,c.grade);}});
test('Exam list contains source metadata only, no answer or user rows',()=>{assert.equal(publicSnapshot.exams.length,7);for(const e of publicSnapshot.exams){assert.equal(typeof e.title,'string');assert.ok(e.questionsCount>0);assert.equal('answers'in e,false);assert.equal('createdBy'in e,false);assert.equal('fileUrl'in e,false);}});
test('Every exam detail uses an MTM route',()=>{for(const e of publicSnapshot.exams){const url=new URL(nativePathForExam(e.id),origin);assert.equal(url.origin,origin);assert.ok(nativeRouteKnown(url.pathname,''));}});
test('Every document detail uses an MTM route',()=>{assert.equal(publicSnapshot.documents.length,5);for(const d of publicSnapshot.documents){const url=new URL(nativePathForDocument(d.id),origin);assert.equal(url.origin,origin);assert.ok(nativeRouteKnown(url.pathname,''));}});
test('Unknown exam and document are not mapped to existing content',()=>{assert.equal(nativeRouteKnown('/thi-thu/missing',''),false);assert.equal(nativeRouteKnown('/tai-lieu/missing',''),false);});
test('Protected native features are not marked connected by front-end routes',()=>{assert.equal(NATIVE_COMPLETION.video,'NOT_CONNECTED');assert.equal(NATIVE_COMPLETION.comments,'NOT_CONNECTED');assert.equal(NATIVE_COMPLETION.login,'NOT_CONNECTED');assert.equal(NATIVE_COMPLETION.published,false);});
test('Reader status covers verified public PDFs only; grading remains disconnected',()=>{assert.equal(NATIVE_COMPLETION.exams,'METADATA_ONLY_NO_GRADING');assert.equal(NATIVE_COMPLETION.documents,'LOCAL_VERIFIED_PUBLIC_PDFS_ONLY');assert.equal(NATIVE_COMPLETION.documentAccountSync,'NOT_CONNECTED');assert.equal(NATIVE_COMPLETION.privateDocumentAccess,'NOT_MIGRATED');});
const failed=rows.filter(r=>!r.pass),report={checkedAt:new Date().toISOString(),scope:'NATIVE_FRONTEND_PUBLIC_METADATA_ROUTING_NOT_FULL_ELEARNING',total:rows.length,passed:rows.length-failed.length,failed:failed.length,rows};if(process.env.MTM_TEST_REPORT)writeFileSync(process.env.MTM_TEST_REPORT,JSON.stringify(report,null,2));console.log(JSON.stringify({total:report.total,passed:report.passed,failed:report.failed,failures:failed}));process.exitCode=failed.length?1:0;
