import assert from 'node:assert/strict';
import {readLessonMaterials,readLessonSources,youtubeVideoId,safeMaterialUrl,type LessonSourceConfig} from '../server/btvn/lesson-materials';
import {HomeworkService} from '../server/btvn/service';
import {MemoryHomeworkRepository,scoresCsv} from '../server/btvn/repository';
import {handleHomework} from '../server/btvn/http';
import examJson from '../server/btvn/demo-exam.json';
import type {PracticeExam} from '../src/native/exams/data';
const config:LessonSourceConfig={sheetId:'FAKE-1',tab:'FAKE',programKey:'2k9',paired:true,classNames:['Lớp giả 8+','Lớp giả 9+'],columns:{className:'Lớp',date:'Ngày',title:'Bài',material:'Tài liệu',handout:'Handout',video:'Video xem lại',homework:'BTVN'}};
const headers=Object.values(config.columns),row=(date:string,video='',className='Lớp giả 9+')=>[className,date,'Bài giả','https://example.invalid/tai-lieu','',video,'https://example.invalid/btvn'];
const read=readLessonMaterials(headers,[row('2026-10-12','https://youtu.be/abcdefghijk'),row('2026-10-13','https://youtu.be/abcdefghijk','Lớp giả 8+'),row('2026-10-14'),row('14/10'),row('2026-02-30'),row('2026-10-16','https://evil.invalid/watch?v=abcdefghijk'),row('2026-10-16','','Lớp khác')],config);
assert.equal(read.lessons.length,2);assert.equal(read.pending.length,3);assert.equal(read.lessons[0].videoId,null);assert.equal(read.lessons[1].classNames.length,2);assert.equal(read.lessons[1].lessonCode,'2k9-2026-10-12');
assert.equal(read.lessons[1].classDates?.['Lớp giả 8+'],'2026-10-13');assert.equal(read.lessons[1].classDates?.['Lớp giả 9+'],'2026-10-12');
assert.throws(()=>readLessonMaterials([...headers,'Bài'],[],config));
const mismatchedSessions=readLessonMaterials(headers,[row('2026-10-12'),row('2026-10-13','https://youtu.be/abcdefghijk')],config);
assert.equal(mismatchedSessions.lessons.length,0);assert.equal(mismatchedSessions.pending[0].code,'source_conflict');assert.deepEqual(mismatchedSessions.pending[0].fields,['videoId']);
for(const url of ['https://youtu.be/abcdefghijk','https://www.youtube.com/watch?v=abcdefghijk','https://www.youtube-nocookie.com/embed/abcdefghijk','https://youtube.com/shorts/abcdefghijk'])assert.equal(youtubeVideoId(url),'abcdefghijk');
for(const url of ['javascript:alert(1)','http://youtu.be/abcdefghijk','https://youtube.com.evil.invalid/watch?v=abcdefghijk','https://youtube.com/watch?v=abc','https://name:pass@youtube.com/watch?v=abcdefghijk'])assert.equal(youtubeVideoId(url),null);
assert.equal(safeMaterialUrl('javascript:alert(1)'),null);
let calls=0;const two=await readLessonSources([config,{...config,sheetId:'FAKE-2'}],async()=>{calls++;return [headers,row('2026-10-14')];});assert.equal(calls,2);assert.equal(two.sources.length,2);assert.equal(two.lessons.length,1);
const mismatchedSources=await readLessonSources([config,{...config,sheetId:'FAKE-2'}],async id=>[headers,row('2026-10-14',id==='FAKE-2'?'https://youtu.be/abcdefghijk':'')]);
assert.equal(mismatchedSources.lessons.length,0);assert.equal(mismatchedSources.pending[0].code,'source_conflict');assert.deepEqual(mismatchedSources.pending[0].sheetIds,['FAKE-1','FAKE-2']);
const exam=examJson as unknown as PracticeExam,lessons=[...read.lessons,{...read.lessons[0],lessonCode:'foreign',classNames:['Lớp khác']}];
let now=Date.parse('2026-10-15T10:00:00+07:00');const repo=new MemoryHomeworkRepository([{studentCode:'FAKE-CODE',fullName:'Học sinh giả',phone:'0900000001',className:'Lớp giả 9+'}]);
const service=new HomeworkService(repo,exam,0,'fake',lessons[0].lessonCode,()=>now,lessons,{[lessons[1].lessonCode]:{...exam,id:exam.id+'-other'},foreign:exam});
const token=service.login({studentCode:'FAKE-CODE'},'ip');assert.equal(service.state(token).lessons?.length,2);assert.throws(()=>service.select(token,'foreign'));
let first=service.start(token);service.submit(token,first.draft!.attemptId,{});service.select(token,lessons[1].lessonCode);assert.equal(service.state(token).attemptsUsed,0);assert.equal(service.state(token).dueAt,null);
const answers=Object.fromEntries(exam.questions.map(q=>[q.id,q.kind==='mc'?q.answer:q.kind==='tf'?q.answer:q.kind==='self'?'':q.acceptedAnswers[0]]));
let other=service.start(token);assert.throws(()=>service.save(token,first.draft!.attemptId,{}));service.submit(token,other.draft!.attemptId,answers);now+=1000;other=service.start(token);service.submit(token,other.draft!.attemptId,{});assert.equal(service.state(token).bestScore,10);
service.reconcileActualClass('FAKE-CODE',now-2000,lessons[1].lessonCode);assert.equal(service.state(token).receipts[0].late,true);assert.equal(service.state(token).lessons?.find(l=>l.lessonCode===lessons[1].lessonCode)?.late,true);
const csv=scoresCsv(repo.all(),lessons[0].lessonCode);assert.ok(csv.includes(lessons[0].lessonCode)&&csv.includes(lessons[1].lessonCode));assert.equal(csv.split('\r\n').filter(Boolean).length,4);
const http=(lessonCode:string,action='state')=>handleHomework(service,{method:'POST',body:{action,lessonCode},cookie:'mtm_btvn_demo='+token,ip:'ip',host:'localhost'});
assert.equal(http(lessons[0].lessonCode).status,200);assert.equal((http(lessons[0].lessonCode).body as any).attemptsUsed,1);assert.equal((http(lessons[1].lessonCode).body as any).attemptsUsed,2);assert.equal(http('foreign').status,404);
assert.equal(JSON.stringify(service.state(token)).includes('0900000001'),false);
console.log('Đợt 4 đạt: 2 nguồn giả, cột/ngày/URL, cặp 8+/9+, lọc lớp, điểm/hạn/lượt riêng, CSV nhiều buổi, hai tab không lẫn bài.');
