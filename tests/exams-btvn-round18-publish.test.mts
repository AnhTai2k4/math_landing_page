import assert from 'node:assert/strict';
import {pathToFileURL} from 'node:url';
import {join} from 'node:path';
import {classOpeningTimes} from '../server/btvn/class-schedule';
import {createBtvnPublishHandler} from '../server/btvn/publish-handler';

assert.deepEqual(classOpeningTimes({classNames:['2K9 9+','2K9 8+'],date:'2026-10-16',classDates:{'2K9 8+':'2026-10-17'}}),{'2K9 9+':'2026-10-16T19:30:00+07:00','2K9 8+':'2026-10-16T19:30:00+07:00'});
assert.equal(classOpeningTimes({classNames:['2K10 9+'],date:'2026-10-18'})['2K10 9+'],'2026-10-16T21:30:00+07:00');
assert.equal(classOpeningTimes({classNames:['Lớp chưa có lịch'],date:'2026-10-18'})['Lớp chưa có lịch'],'2026-10-18T21:30:00+07:00');
assert.equal(classOpeningTimes({classNames:['2K9 9+'],date:'2026-10-18'})['2K9 9+'],'2026-10-18T21:30:00+07:00');
assert.throws(()=>classOpeningTimes({classNames:['x'],date:'2026-02-30'}));
let status='da_dang',updates:any[]=[];
const secret='local-fixture-secret-'.repeat(3);
const handler=createBtvnPublishHandler({async rpc(action,payload){if(action==='lookup')return {status};assert.equal(action,'update_material');updates.push(payload);return {status:'updated'};},async upload(){assert.fail('Cập nhật metadata không tải assets');}},secret);
const request=async(material:any,extra={},key=secret)=>handler(new Request('https://fake.invalid',{method:'POST',headers:{'X-MTM-Publish-Secret':key},body:JSON.stringify({action:'update_material',lesson_key:'fake-lesson',material,...extra})}));
const patch={videoId:'abcdefghijk',videoUrl:'https://youtu.be/abcdefghijk',handoutUrl:'https://example.invalid/handout',title:'Bài kiểm thử',classOpensAt:{'2K9 9+':'2026-10-16T19:30:00+07:00'}};
assert.equal((await request(patch)).status,200);assert.deepEqual(updates[0],{lesson_key:'fake-lesson',material:patch});
for(const p of [{exam:{}},{assets:[]},{classNames:['x']},{date:'2026-01-01'},{videoId:'bad'},{videoUrl:'http://example.invalid'},{materialUrl:'https://user:secret@example.invalid'},{classOpensAt:{x:'2026-10-16'}},{classOpensAt:[]},{title:''},{}])assert.equal((await request(p)).status,422);
assert.equal((await request(patch,{exam:{}})).status,422);
assert.equal((await request(patch,{},'wrong')).status,401);assert.equal(updates.length,1);
status='loi';assert.equal((await request(patch)).status,422);status='da_dang';
const cli=await import(pathToFileURL(join(process.env.MTM_ROOT??process.cwd(),'scripts/update-btvn-material.mjs')).href);
let calls=0;const transport=async()=>{calls++;return new Response('{"status":"updated"}');};
assert.equal((await cli.updateMaterial('fake-lesson',patch,{transport})).mode,'dry-run');assert.equal(calls,0);
await assert.rejects(cli.updateMaterial('fake-lesson',{exam:{}},{live:true,transport}));assert.equal(calls,0);
const env={BTVN_PUBLISH_URL:'https://fake.supabase.co/functions/v1/mtm-btvn-publish',BTVN_PUBLISH_SECRET:secret};
assert.equal((await cli.updateMaterial('fake-lesson',patch,{live:true,env,transport})).written,true);assert.equal(calls,1);
assert.equal((await cli.openingBackfill([{lessonCode:'fake-lesson',classNames:['2K10 9+'],date:'2026-10-18'}]))[0].written,false);
await assert.rejects(cli.openingBackfill([{lessonCode:'fake-lesson',classNames:['x'],date:'2026-02-30'}]));
console.log('ĐẠT đợt 18 publisher: lịch theo lớp, fallback, whitelist, URL, secret, không assets, CLI và backfill dry-run.');
