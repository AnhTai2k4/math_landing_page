import assert from 'node:assert/strict';import {writeFileSync} from 'node:fs';
import {foldText,searchIndex,buildTextIndex,SEARCH_LIMITS,type TextIndex} from '../src/native/reader-search';
import {decodePosition,readPosition,savePosition,forgetPosition,positionKey,type PositionStorage} from '../src/native/reader-position';import files from '../src/native/reader-files.json';
const rows:{name:string;pass:boolean;error?:string}[]=[];async function test(name:string,fn:()=>unknown|Promise<unknown>){try{await fn();rows.push({name,pass:true});}catch(e){rows.push({name,pass:false,error:e instanceof Error?e.message:String(e)});}}
const index=(texts:string[]):TextIndex=>({pages:texts.map((text,n)=>({page:n+1,text})),pageCount:texts.length,unreadable:[],clipped:[]});
await test('Vietnamese accents and case fold without changing source text',()=>{const i=index(['HÀM SỐ ĐỒ THỊ']);const r=searchIndex(i,'ham so');assert.equal(r.hits.length,1);assert.equal(r.hits[0].match,'HÀM SỐ');assert.equal(i.pages[0].text,'HÀM SỐ ĐỒ THỊ');});
await test('Vietnamese stroked d can be entered without accents',()=>assert.equal(searchIndex(index(['Đường thẳng']), 'duong thang').hits[0].match,'Đường thẳng'));
await test('Combining accents retain correct highlight offsets',()=>{const text='Ha\u0300m sô\u0301';const hit=searchIndex(index([text]),'ham so').hits[0];assert.equal(hit.match,text);assert.equal(hit.end,text.length);});
await test('Collapsed PDF spacing and linebreaks match phrases',()=>assert.equal(searchIndex(index(['hàm  \n  số']), 'ham so').hits[0].match,'hàm  \n  số'));
await test('Compatibility ligatures retain original match text',()=>assert.equal(searchIndex(index(['oﬃce']), 'office').hits[0].match,'oﬃce'));
await test('Regex-looking input is a literal search, not executable',()=>{const r=searchIndex(index(['x [a.*] y aZZZ']), '[a.*]');assert.equal(r.hits.length,1);assert.equal(r.hits[0].match,'[a.*]');});
await test('HTML-looking source stays plain string results',()=>{const r=searchIndex(index(['<script>alert(1)</script>']), 'script');assert.equal(r.hits.length,2);assert.equal(r.hits[0].before,'<');});
await test('First and last characters are valid matches',()=>{const r=searchIndex(index(['ab something ab']), 'ab');assert.equal(r.hits[0].start,0);assert.equal(r.hits[1].end,15);});
await test('Results are in page and text order',()=>assert.deepEqual(searchIndex(index(['xx xx','xx']), 'xx').hits.map(h=>[h.page,h.start]),[[1,0],[1,3],[2,0]]));
await test('Match cap reports that more matches exist',()=>{const r=searchIndex(index(['xx '.repeat(205)]),'xx');assert.equal(r.hits.length,200);assert.equal(r.limited,true);});
await test('Exactly the match limit is not mislabeled truncated',()=>assert.equal(searchIndex(index(['xx '.repeat(200)]),'xx').limited,false));
await test('Queries too short or long are refused',()=>{for(const q of ['','a','  ','x'.repeat(101)])assert.throws(()=>searchIndex(index(['anything']),q));});
await test('Absent term returns explicit empty hits',()=>assert.deepEqual(searchIndex(index(['toán học']),'something').hits,[]));
await test('Result count is restricted to pages actually matching',()=>assert.equal(searchIndex(index(['xx xx','nothing','xx']),'xx').pagesWithMatches,2));
await test('Build reads every text page and reports progress',async()=>{const progress:number[]=[];const doc={numPages:3,async getPage(n:number){return{async getTextContent(){return{items:[{str:'Trang '+n},{str:'hàm số'}, {type:'markedContent'}]};}};}};const r=await buildTextIndex(doc,new AbortController().signal,n=>progress.push(n));assert.deepEqual(progress,[1,2,3]);assert.equal(searchIndex(r,'ham so').hits.length,3);});
await test('Unreadable page is flagged rather than invented as empty successful text',async()=>{const r=await buildTextIndex({numPages:2,async getPage(n:number){if(n===2)throw Error('broken');return{async getTextContent(){return{items:[{str:'hello'}]};}};}},new AbortController().signal);assert.deepEqual(r.unreadable,[2]);assert.equal(r.pages.length,1);});
await test('Image-only page remains empty without OCR',async()=>{const r=await buildTextIndex({numPages:1,async getPage(){return{async getTextContent(){return{items:[]};}};}},new AbortController().signal);assert.equal(r.pages[0].text,'');assert.deepEqual(r.unreadable,[]);});
await test('Oversize page text is bounded and visibly flagged',async()=>{const r=await buildTextIndex({numPages:1,async getPage(){return{async getTextContent(){return{items:[{str:'a'.repeat(SEARCH_LIMITS.pageCharacters+50)}]};}};}},new AbortController().signal);assert.equal(r.pages[0].text.length,SEARCH_LIMITS.pageCharacters);assert.deepEqual(r.clipped,[1]);});
await test('Aborted build makes no further getPage call',async()=>{let called=0;await assert.rejects(()=>buildTextIndex({numPages:3,async getPage(){called++;throw Error('not expected');}},AbortSignal.abort()),(e:any)=>e.name==='AbortError');assert.equal(called,0);});
await test('Cancel while text promise is pending promptly rejects',async()=>{const c=new AbortController();const promise=buildTextIndex({numPages:1,async getPage(){return{getTextContent:()=>new Promise(()=>{})};}},c.signal);setTimeout(()=>c.abort(),5);await assert.rejects(()=>promise,(e:any)=>e.name==='AbortError');});
await test('Document page count cannot be unbounded',()=>assert.rejects(()=>buildTextIndex({numPages:201,async getPage(){throw Error();}},new AbortController().signal)));
const file=files.files[0],now=1800000000000,valid={v:1,hash:file.sha256,page:3,zoom:125,at:now};
const memory=new Map<string,string>();const store:PositionStorage={getItem:k=>memory.get(k)??null,setItem:(k,v)=>{memory.set(k,v);},removeItem:k=>{memory.delete(k);}};
await test('Empty storage returns no fabricated reading progress',()=>assert.equal(readPosition(store,file,now).state,'empty'));
await test('Valid position saves and roundtrips with readback verification',()=>{assert.equal(savePosition(store,file,3,125,now).state,'saved');assert.deepEqual(decodePosition(memory.get(positionKey(file))!,file,now),{state:'saved',value:valid});});
await test('Local payload excludes title, name, query and account data',()=>assert.deepEqual(Object.keys(JSON.parse(memory.get(positionKey(file))!)),['v','hash','page','zoom','at']));
await test('Equivalent source aliases share position by exact PDF hash',()=>assert.equal(positionKey({...file,id:'a'.repeat(24)}),positionKey(file)));
await test('Different PDF hash never reuses a remembered position',()=>{const other=files.files.find(f=>f.sha256!==file.sha256)!;assert.equal(readPosition(store,other,now).state,'empty');assert.equal(decodePosition(JSON.stringify(valid),other,now).state,'invalid');});
await test('Corrupt storage is reported and not overwritten automatically',()=>{store.setItem(positionKey(file),'broken-json');assert.equal(savePosition(store,file,4,100,now).state,'invalid');assert.equal(store.getItem(positionKey(file)),'broken-json');});
await test('Unknown version and additional fields are rejected',()=>{for(const x of [{...valid,v:2},{...valid,password:'not-real'},{...valid,page:'3'}])assert.equal(decodePosition(JSON.stringify(x),file,now).state,'invalid');});
await test('Bounds reject invalid page, zoom and future timestamp',()=>{for(const x of [{...valid,page:0},{...valid,page:999},{...valid,zoom:300},{...valid,at:now+300001}])assert.equal(decodePosition(JSON.stringify(x),file,now).state,'invalid');});
await test('Oversize local position payload is ignored',()=>assert.equal(decodePosition('x'.repeat(513),file,now).state,'invalid'));
await test('Storage read denial does not break the reader contract',()=>assert.equal(readPosition({getItem(){throw Error('SecurityError');},setItem(){},removeItem(){}},file,now).state,'unavailable'));
await test('Storage write quota failure reports unsaved state',()=>assert.equal(savePosition({getItem(){return null;},setItem(){throw Error('quota');},removeItem(){}},file,3,100,now).state,'unavailable'));
await test('Unavailable storage does not pretend persistence succeeded',()=>assert.equal(savePosition(null,file,3,100,now).state,'unavailable'));
await test('Explicit deletion removes only this file position',()=>{store.setItem('unrelated:user-data','keep');assert.equal(forgetPosition(store,file),true);assert.equal(store.getItem('unrelated:user-data'),'keep');assert.equal(readPosition(store,file,now).state,'empty');});
await test('Delete denial is not falsely reported as success',()=>assert.equal(forgetPosition({getItem(){return 'exists';},setItem(){},removeItem(){throw Error();}},file),false));
const failed=rows.filter(x=>!x.pass),report={at:new Date().toISOString(),scope:'PURE_PUBLIC_READER_TEXT_SEARCH_AND_LOCAL_POSITION',total:rows.length,passed:rows.length-failed.length,failed:failed.length,rows,networkRequests:0,realBrowserUserDataUsed:false};if(process.env.MTM_TEST_REPORT)writeFileSync(process.env.MTM_TEST_REPORT,JSON.stringify(report,null,2));console.log(JSON.stringify({total:report.total,passed:report.passed,failed:report.failed,failures:failed}));process.exitCode=failed.length?1:0;
