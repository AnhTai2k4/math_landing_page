import assert from 'node:assert/strict';
import {readRosterSheet,importRoster,type RosterConfig} from '../server/btvn/roster';
import {MemoryHomeworkRepository} from '../server/btvn/repository';
import {HomeworkService,HomeworkError,GATE_ERROR} from '../server/btvn/service';
import {handleHomework} from '../server/btvn/http';
import examJson from '../server/btvn/demo-exam.json';
import type {PracticeExam} from '../src/native/exams/data';
const config:RosterConfig={sheetId:'FAKE-ROUND3',tabs:[{tab:'NEW',className:'2K10 NEW',cohort:'2K10'},{tab:'OLD',className:'2K10 OLD',cohort:'2K10'}],columns:{fullName:'Tên',phone:'HS',parentPhone:'PH',className:'Lớp',leave:'Nghỉ',birthDate:'Sinh'}};
const headers=['Tên','HS','PH','Lớp','Nghỉ','Sinh'];
const old=['Thử Chuyển','0900000081','','2K10 OLD','','2010-01-01'];
const before=importRoster(headers,[old],config,'OLD',{});
const moved=[...old];moved[4]='CHUYỂN SANG LỚP 2K10 NEW';
const rows={OLD:[headers,moved,['Thử Nghỉ','0900000082','','2K10 OLD','học 1 buổi rồi nghỉ','']],NEW:[headers,['Thử Chuyển','0900000081','','2K10 NEW','','2010-01-01'],['Thử PH','','0900000083','2K10 NEW','','2010-01-02']]};
const read=async(_id:string,tab:string)=>rows[tab as keyof typeof rows];
const result=await readRosterSheet(config,read,before.registry);
assert.equal(result.students.length,2);assert.equal(result.excluded,1);
assert.equal(result.students[0].studentCode,before.students[0].studentCode);assert.equal(result.students[0].className,'2K10 NEW');
const again=await readRosterSheet(config,read,result.registry);assert.deepEqual(again.students,result.students);
assert.match(result.students[1].studentCode,/^HS-[a-f0-9]{32}$/);assert.ok(!result.students[1].studentCode.includes('0900000083'));
assert.throws(()=>importRoster(headers,[[...old.slice(0,4),'CHUYỂN SANG LỚP không rõ','']],config,'OLD',{}));
const movedInName=[...old];movedInName[0]+=' (CHUYỂN SANG LỚP 2K10 NEW)';
const fromName=importRoster(headers,[movedInName],config,'OLD',before.registry);
assert.equal(fromName.students[0].fullName,'Thử Chuyển');assert.equal(fromName.students[0].studentCode,before.students[0].studentCode);
assert.equal(fromName.students[0].className,'2K10 NEW');
let now=1000000;
const service=new HomeworkService(new MemoryHomeworkRepository(result.students),examJson as unknown as PracticeExam,0,undefined,undefined,()=>now);
const code={studentCode:result.students[1].studentCode};
const identity={fullName:'thu ph',phone:'+84 900 000 083',className:'2K10 NEW'};
const token=service.login(code,'code-ok'),fallback=service.login(identity,'identity-ok');
assert.equal(service.state(token).fullName,'Thử PH');assert.deepEqual(service.state(token),service.state(fallback));
const denied=(fn:()=>unknown,status:number)=>assert.throws(fn,(e:unknown)=>e instanceof HomeworkError&&e.status===status&&e.message===GATE_ERROR);
denied(()=>service.login({...identity,...code},'mixed'),401);
denied(()=>service.login({studentCode:'wrong'},'invalid-code'),401);
denied(()=>service.login({...identity,phone:'0900999999'},'invalid-phone'),401);
for(let i=0;i<5;i++)denied(()=>service.login({studentCode:'wrong-fixed'},'rotate-'+i),401);
denied(()=>service.login({studentCode:'wrong-fixed'},'new-ip'),429);
for(let i=0;i<5;i++)denied(()=>service.login({studentCode:'rotate-code-'+i},'shared-ip'),401);
denied(()=>service.login(identity,'shared-ip'),429);denied(()=>service.login(code,'shared-ip'),429);
now+=15*60000;assert.ok(service.login(code,'shared-ip'));
const response=handleHomework(service,{method:'POST',body:{action:'login',gate:code},host:'localhost',ip:'http'});
assert.equal(response.status,200);assert.match(response.headers['Set-Cookie'],/HttpOnly/);
const payload=JSON.stringify(response.body);assert.ok(!payload.includes(code.studentCode));assert.ok(!payload.includes('0900000083'));assert.ok(!payload.includes('Thử Chuyển'));
const duplicate=new HomeworkService(new MemoryHomeworkRepository([result.students[1],{...result.students[1],studentCode:'OTHER-FAKE'}]),service.exam,0);
denied(()=>duplicate.login(identity,'duplicate'),401);
console.log('Đợt 3 đạt: mã/3 trường, HS/PH, mã sai, limiter đổi IP/đổi mã/chung hai cổng, cookie, dữ liệu riêng, nghỉ 1 buổi, chuyển lớp giữ mã, nhập lại ổn định.');
