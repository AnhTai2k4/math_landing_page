import assert from 'node:assert/strict';
import {createRequire} from 'node:module';
import {join} from 'node:path';
import {readFileSync} from 'node:fs';
const root=process.env.MTM_ROOT!,require=createRequire(join(root,'package.json'));
const {buildSync}=require('esbuild'),React=require('react'),{renderToStaticMarkup}=require('react-dom/server');
const code=buildSync({entryPoints:[join(root,'src/native/homework/AdminHomework.tsx')],bundle:true,write:false,platform:'node',format:'cjs',jsx:'automatic',packages:'external',loader:{'.css':'empty'},logLevel:'silent'}).outputFiles[0].text;
const mod={exports:{} as any};new Function('require','module','exports',code)(require,mod,mod.exports);
const {StudentPhotoModeration,withPhotoStatuses}=mod.exports;
const student={id:'00000000-0000-4000-8000-000000000001',classId:'class-fixture',profile:{fullName:'Học sinh thử',centerClass:'Lớp thử',school:'Trường thử',schoolClass:'10A',classId:'class-fixture',publicAlias:'PRIVATE-ALIAS'}};
let calls:any[]=[];
const props={student:{...student,photoHidden:false},busy:false,onModerate:(s:any,hidden:boolean)=>calls.push({id:s.id,hidden})};
const all=(tree:any,p:(n:any)=>boolean):any[]=>!tree||typeof tree!=='object'?[]:Array.isArray(tree)?tree.flatMap(n=>all(n,p)):[...(p(tree)?[tree]:[]),...all(tree.props?.children,p)];
const button=(p:any)=>all(StudentPhotoModeration(p),n=>n.type==='button')[0];
assert.match(renderToStaticMarkup(React.createElement(StudentPhotoModeration,props)),/Ẩn ảnh công khai/);
button(props).props.onClick();assert.deepEqual(calls,[{id:student.id,hidden:true}]);
const hidden={...props,student:{...student,photoHidden:true}};
assert.match(renderToStaticMarkup(React.createElement(StudentPhotoModeration,hidden)),/Cho hiện lại ảnh/);
button(hidden).props.onClick();assert.deepEqual(calls[1],{id:student.id,hidden:false});
for(const p of [{...props,busy:true},{...props,student}]){assert.equal(button(p).props.disabled,true);button(p).props.onClick();}
assert.equal(calls.length,2,'bận hoặc chưa tải cờ không được gửi tác vụ');
const html=renderToStaticMarkup(React.createElement(StudentPhotoModeration,props));assert.doesNotMatch(html,/PRIVATE-ALIAS|00000000|class-fixture/);
assert.deepEqual(withPhotoStatuses([student],{items:[{studentId:student.id,photoHidden:true}]}),[{...student,photoHidden:true}]);
assert.deepEqual(withPhotoStatuses([],{items:[]}),[]);
for(const value of [null,{items:[]},{items:[{studentId:'khác',photoHidden:true}]},{items:[{studentId:student.id,photoHidden:'true'}]},{items:[{studentId:student.id,photoHidden:true},{studentId:student.id,photoHidden:false}]}])assert.throws(()=>withPhotoStatuses([student],value));
const source=readFileSync(join(root,'src/native/homework/AdminHomework.tsx'),'utf8');
assert.match(source,/studentAppearanceChanged\(\);await refresh\(\)/,'giáo vụ đổi ảnh cũng báo các tab tải lại');
assert.match(source,/ownedRpc\('mtm_btvn_photo_status',\{p_students:s\.map/);
assert.match(source,/ownedRpc<\{ok:boolean;photoHidden:boolean\}>\('mtm_btvn_photo_moderate',\{p_student:student\.id,p_hidden:hidden\}\)/);
assert.match(source,/StudentPhotoModeration[\s\S]*onModerate=[\s\S]*setConfirmation/);
console.log('Đạt giáo vụ ẩn/hiện ảnh: trạng thái owner-only, đúng học sinh/boolean, xác nhận, khóa khi bận hoặc chưa tải và không render mã riêng.');
