mkdirSync(join(root,'.qa-temp/dot-12'),{recursive:true});
writeFileSync(join(root,'.qa-temp/dot-12/empty-ssr.html'),'<!doctype html><html lang="vi"><meta charset="utf-8">'+html+'</html>');
const session='a'.repeat(64),calls:string[]=[];
