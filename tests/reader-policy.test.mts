import assert from 'node:assert/strict';import {createHash} from 'node:crypto';import {writeFileSync,readFileSync} from 'node:fs';import {join} from 'node:path';
import {validateReaderFile,readerView,readerPath,fetchReaderBytes,ReaderError,READER_LIMIT,type ReaderFile} from '../src/native/reader-policy';import manifest from '../src/native/reader-files.json';
const payload=new TextEncoder().encode('%PDF-1.7\nsynthetic-policy-test-only\n%%EOF');const fixture:ReaderFile={id:'6a54be473fd8333b187a0152',path:'',sha256:createHash('sha256').update(payload).digest('hex'),bytes:payload.length,pages:13,observedContents:'Test only',sourceGrouping:1,sourceMetadataNeedsReview:false};fixture.path='/learning-documents/'+fixture.sha256+'.pdf';
const rows:{name:string;pass:boolean;error?:string}[]=[];async function test(name:string,fn:()=>unknown|Promise<unknown>){try{await fn();rows.push({name,pass:true});}catch(e){rows.push({name,pass:false,error:e instanceof Error?e.message:String(e)});}}
const mock=(body:BodyInit=payload,headers:Record<string,string>={'content-type':'application/pdf'},status=200)=>(async()=>new Response(body,{headers,status}))as typeof fetch;
const load=(file=fixture,fetcher=mock(),signal=new AbortController().signal)=>fetchReaderBytes(file,signal,fetcher);
const rejected=(fn:()=>Promise<unknown>,code:string)=>assert.rejects(fn,(e:unknown)=>e instanceof ReaderError&&e.code===code);
await test('Default page and fit zoom are deterministic',()=>assert.deepEqual(readerView('',13),{page:1,zoom:100}));
await test('Page and zoom restore from native URL',()=>assert.deepEqual(readerView('?trang=8&zoom=150',13),{page:8,zoom:150}));
await test('Out-of-range URL page is bounded',()=>assert.equal(readerView('?trang=999',13).page,13));
await test('Invalid, negative and repeated page values are safe',()=>{for(const q of ['?trang=-1','?trang=0','?trang=1.4','?trang=nan','?trang=3&trang=4'])assert.equal(readerView(q,13).page,1);});
await test('Zoom must match a supported value',()=>{for(const q of ['?zoom=900','?zoom=foo','?zoom=100&zoom=200'])assert.equal(readerView(q,13).zoom,100);});
await test('Reader links remain local and roundtrip exactly',()=>{const url=new URL(readerPath(fixture,7,125),'https://www.minhthanhmath.vn');assert.equal(url.origin,'https://www.minhthanhmath.vn');assert.deepEqual(readerView(url.search,13),{page:7,zoom:125});});
await test('Builder rejects invalid pages and zoom',()=>{assert.throws(()=>readerPath(fixture,0,100));assert.throws(()=>readerPath(fixture,14,100));assert.throws(()=>readerPath(fixture,1,300));});
await test('Manifest cannot become an external proxy',()=>{for(const p of ['https://evil.invalid/x.pdf','//evil.invalid/a.pdf','/learning-documents/../secrets','data:application/pdf,abc'])assert.throws(()=>validateReaderFile({...fixture,path:p}));});
await test('Manifest limits size, identity and page count',()=>{for(const f of [{...fixture,bytes:READER_LIMIT+1},{...fixture,pages:201},{...fixture,id:'../any'}])assert.throws(()=>validateReaderFile(f));});
await test('Exact PDF bytes pass integrity verification',async()=>assert.deepEqual(await load(),payload));
await test('Reader fetch does not send credentials or accept redirects',async()=>{let recorded:RequestInit|undefined;const f=(async(_url:unknown,options:RequestInit)=>{recorded=options;return new Response(payload,{headers:{'content-type':'application/pdf'}});})as typeof fetch;await load(fixture,f);assert.equal(recorded?.credentials,'omit');assert.equal(recorded?.redirect,'error');assert.equal(recorded?.method,'GET');});
await test('HTTP failure cannot appear as a valid PDF',()=>rejected(()=>load(fixture,mock('missing',{},404)),'FILE_UNAVAILABLE'));
await test('HTML login wall refused',()=>rejected(()=>load(fixture,mock('<html>login</html>',{'content-type':'text/html'})),'NOT_PDF'));
await test('Oversized content-length refused before buffering',()=>rejected(()=>load(fixture,mock(payload,{'content-type':'application/pdf','content-length':String(READER_LIMIT+1)})),'FILE_TOO_LARGE'));
await test('Missing content-length still receives bounded validation',async()=>assert.equal((await load(fixture,mock())).length,payload.length));
await test('Truncated bytes fail without parsing or showing content',()=>rejected(()=>load(fixture,mock(payload.slice(0,-1))),'SIZE_MISMATCH'));
await test('Stream exceeding declared manifest size is canceled',async()=>{let canceled=false;const stream=new ReadableStream<Uint8Array>({start(c){c.enqueue(payload);c.enqueue(new Uint8Array(2));},cancel(){canceled=true;}});await rejected(()=>load(fixture,mock(stream)),'SIZE_MISMATCH');assert.ok(canceled);});
await test('Same-size corrupt PDF fails SHA-256 check',async()=>{const changed=payload.slice();changed[10]^=1;await rejected(()=>load(fixture,mock(changed)),'HASH_MISMATCH');});
await test('Forged PDF MIME does not bypass the header check',async()=>{const changed=payload.slice();changed[0]=65;await rejected(()=>load(fixture,mock(changed)),'NOT_PDF');});
await test('Canceled navigation stops reading',()=>assert.rejects(()=>load(fixture,mock(),AbortSignal.abort()),(e:unknown)=>e instanceof Error&&e.name==='AbortError'));
await test('All five manifest entries match source bytes on disk',()=>{assert.equal(manifest.files.length,5);for(const f of manifest.files){validateReaderFile(f);const bytes=readFileSync(join(process.cwd(),'public',f.path.slice(1)));assert.equal(bytes.length,f.bytes);assert.equal(createHash('sha256').update(bytes).digest('hex'),f.sha256);}});
await test('Duplicate source references retained without duplicate assets',()=>{assert.equal(new Set(manifest.files.map(f=>f.path)).size,2);assert.deepEqual([...new Set(manifest.files.map(f=>f.pages))].sort((a,b)=>a-b),[13,19]);});
await test('Known source label mismatches stay disclosed',()=>{assert.ok(manifest.files.some(f=>f.sourceMetadataNeedsReview));assert.ok(manifest.files.every(f=>f.observedContents.length>20));});
const failed=rows.filter(r=>!r.pass),report={checkedAt:new Date().toISOString(),scope:'PUBLIC_READER_POLICY_INTEGRITY_AND_MANIFEST',total:rows.length,passed:rows.length-failed.length,failed:failed.length,rows,externalRequests:0};if(process.env.MTM_TEST_REPORT)writeFileSync(process.env.MTM_TEST_REPORT,JSON.stringify(report,null,2));console.log(JSON.stringify({total:report.total,passed:report.passed,failed:report.failed,failures:failed}));process.exitCode=failed.length?1:0;
